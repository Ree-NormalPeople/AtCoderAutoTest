{
  "manifest_version": 3,
  "name": "AtCoder Online Test Runner",
  "version": "1.0.0",
  "description": "AtCoder問題ページで入力例を使って全テストをオンライン実行します。",
  "permissions": [],
  "host_permissions": [
    "https://api.paiza.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "atcoder-online-test-runner@example.com",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://atcoder.jp/contests/*/tasks/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
