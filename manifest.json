{
  "manifest_version": 3,
  "name": "AtCoder Online Test Runner",
  "version": "1.2.0",
  "description": "AtCoder問題ページで入力例を使って全テストを実行します（本体高速実行＋paiza.IOフォールバック）。",
  "permissions": [],
  "host_permissions": [
    "https://api.paiza.io/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/pyodide/*"
      ],
      "matches": [
        "https://atcoder.jp/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "atcoder-online-test-runner@example.com",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://atcoder.jp/contests/*/tasks/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
